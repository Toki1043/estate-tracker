{
  "name": "estate-tracker",
  "version": "1.0.2",
  "description": "Monitor ogłoszeń nieruchomości (Otodom, OLX, Gratka, Morizon, Nieruchomosci-online) — serwer z alertami na Telegram i aplikacja desktopowa",
  "main": "electron/main.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/index.js",
    "app": "electron .",
    "test:portals": "node scripts/test-portals.js",
    "dist:mac": "electron-builder --mac --universal --publish never",
    "dist:win": "electron-builder --win --x64 --publish never",
    "dist": "electron-builder --mac --universal --win --x64 --publish never"
  },
  "engines": {
    "node": ">=18.17"
  },
  "license": "MIT",
  "dependencies": {
    "@geoman-io/leaflet-geoman-free": "2.19.3",
    "cheerio": "^1.0.0",
    "express": "^4.22.3",
    "leaflet": "^1.9.4"
  },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "26.17.0"
  },
  "productName": "Estate Tracker",
  "author": "Estate Tracker",
  "estateTracker": {
    "updateRepo": "Toki1043/estate-tracker"
  },
  "build": {
    "appId": "pl.estatetracker.app",
    "productName": "Estate Tracker",
    "copyright": "Estate Tracker",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "public/**/*",
      "electron/**/*",
      "package.json",
      "!**/*.map"
    ],
    "asar": true,
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "icon": "build/icon.png",
      "identity": "-",
      "hardenedRuntime": false,
      "artifactName": "Estate-Tracker-${version}-mac.${ext}"
    },
    "dmg": {
      "title": "Estate Tracker ${version}"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Estate Tracker",
      "artifactName": "Estate-Tracker-${version}-instalator-Windows.${ext}",
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "artifactName": "Estate-Tracker-${version}-portable-Windows.${ext}"
    }
  }
}
