# Skopiuj do /etc/estate-tracker.env (chmod 600). Wszystkie wartości są opcjonalne —
# to samo ustawisz w panelu (Ustawienia). Zmienne środowiskowe mają pierwszeństwo przed panelem.

PORT=3100
# HOST=127.0.0.1          # tylko lokalnie (np. za reverse proxy albo przez tunel SSH)

# PANEL_USER=admin
# PANEL_PASSWORD=<twoje-haslo>

# TELEGRAM_BOT_TOKEN=<token-od-BotFather>
# TELEGRAM_CHAT_ID=<id-czatu, np. -100…>
# TELEGRAM_THREAD_ID=<id-watku>

# DATA_DIR=<katalog-instalacji>/data
